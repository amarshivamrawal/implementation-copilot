# Rocketlane API
ROCKETLANE_API_KEY=your_rocketlane_api_key_here
ROCKETLANE_BASE_URL=https://api.rocketlane.com/api/1.0

# Microsoft OneDrive / Graph API (for VTT files)
ONEDRIVE_CLIENT_ID=your_azure_app_client_id
ONEDRIVE_CLIENT_SECRET=your_azure_app_client_secret
ONEDRIVE_TENANT_ID=your_azure_tenant_id
ONEDRIVE_USER_EMAIL=your_onedrive_user@zenoti.com

# Configuration
# Comma-separated list of Zenoti team email domains
ZENOTI_TEAM_DOMAINS=zenoti.com
# Days threshold for response delay alert
RESPONSE_DELAY_THRESHOLD_DAYS=2
